{
  "name": "middleton-grange-website",
  "version": "0.1.0",
  "private": true,
  "description": "Middleton Grange School website — scraped archive + new design",
  "type": "module",
  "scripts": {
    "dev": "serve public --listen 4321 --no-port-switching",
    "build": "node scripts/build.js",
    "build:test": "node scripts/build.js --limit=10",
    "build:no-media": "node scripts/build.js --no-media",
    "scrape": "node scripts/scrape.js",
    "scrape:resume": "node scripts/scrape.js --resume",
    "scrape:test": "node scripts/scrape.js --limit=5",
    "upgrade-images": "node scripts/upgrade-images.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "marked": "^18.0.3",
    "p-queue": "^8.0.1",
    "slugify": "^1.6.6",
    "turndown": "^7.1.3"
  },
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
